{
  "name": "ditto",
  "version": "0.1.0",
  "private": true,
  "description": "Campus Wednesday Drop matching — WeChat mini program + NestJS API",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:api": "pnpm --filter @ditto/api start:dev",
    "dev:mini:h5": "pnpm --filter @ditto/mini dev:h5",
    "dev:mini:mp-weixin": "pnpm --filter @ditto/mini dev:mp-weixin",
    "build:api": "pnpm --filter @ditto/api build",
    "build:mini:h5": "pnpm --filter @ditto/mini build:h5",
    "build:mini:mp-weixin": "pnpm --filter @ditto/mini build:mp-weixin",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:java:up": "docker compose --env-file deploy/.env -f docker-compose.java.yml up -d --build",
    "db:java:down": "docker compose --env-file deploy/.env -f docker-compose.java.yml down",
    "db:migrate": "pnpm --filter @ditto/api prisma:migrate",
    "db:seed": "pnpm --filter @ditto/api prisma:seed",
    "test:api": "pnpm --filter @ditto/api test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
