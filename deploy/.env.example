# Copy to deploy/.env on the machine that runs Compose.
# deploy/.env is gitignored. Do not commit it, and do not put a server IP in either file.

MYSQL_DATABASE=ditto
MYSQL_USER=ditto
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Host ports. Change them if something else is already listening.
MYSQL_PORT=3306
API_JAVA_PORT=8080
H5_PORT=8088
