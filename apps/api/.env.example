# Copy to apps/api/.env. Never commit the real file.
DATABASE_URL=postgresql://ditto:ditto@localhost:5432/ditto?schema=public
PORT=3000

# Dev-only signing key. Replace outside local laptops.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_SECONDS=604800

# WeChat mini program. Leave the secret empty in git.
# WECHAT_STUB=true skips code2session and returns a deterministic openid.
# Set WECHAT_STUB=false only after the live exchange is implemented.
WECHAT_STUB=true
WECHAT_APPID=
WECHAT_APP_SECRET=

# 订阅消息 template id from the WeChat MP admin (匹配海报).
WECHAT_TEMPLATE_MATCH_POSTER=

# Header x-dev-token for cutoff / release / matching preview.
DEV_ADMIN_TOKEN=dev-admin
