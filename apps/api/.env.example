# Copy to apps/api/.env. Never commit the real file.
DATABASE_URL=postgresql://ditto:ditto@localhost:5432/ditto?schema=public
PORT=3000

# Dev-only signing key. Replace outside local laptops.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_SECONDS=604800

# WeChat mini program. Leave the secret empty in git.
# WECHAT_STUB=true skips code2session and returns a deterministic openid.
# Set WECHAT_STUB=false only after the live exchange is implemented.
WECHAT_STUB=true
WECHAT_APPID=
WECHAT_APP_SECRET=

# 订阅消息 template id from the WeChat MP admin (匹配海报).
WECHAT_TEMPLATE_MATCH_POSTER=

# Header x-dev-token for cutoff / release / matching preview.
DEV_ADMIN_TOKEN=dev-admin

# Friday demo: treat OTP login as student-verified. Set false outside the demo.
STUDENT_VERIFY_SKIP=true

# Public H5 origin used in SMS deep links. Production: https://aiditto.cn
H5_PUBLIC_BASE_URL=http://localhost:5173

# Echo the OTP in the JSON response. Local demo only. Set false before any shared host.
OTP_DEV_ECHO=true
# Preview login accepts any 6-digit code. Set false to require the stored code.
OTP_PREVIEW_ANY_CODE=true
OTP_PEPPER=dev-only-change-me

# Aliyun SMS (Dysmsapi SendSms). Leave secrets empty in git.
# SMS_PROVIDER=aliyun only calls Aliyun when the three key fields below are all set.
# Otherwise the provider stays stub and returns accepted=false.
SMS_PROVIDER=stub
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
# OTP template variables: code
ALIYUN_SMS_TEMPLATE_OTP=
# Match template variables: content, url
# If TEMPLATE_MATCH is empty, TEMPLATE_OTP is reused and content+url are stuffed into `code`.
# Risk: OTP templates usually allow digits only, so that reuse is rejected by Aliyun.
ALIYUN_SMS_TEMPLATE_MATCH=
