# Host-side run of the jar, against a published MySQL port.
# Copy to apps/api-java/.env (gitignored) and export it. Do not commit passwords.
# Compose uses deploy/.env instead and injects the same settings into the container.

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/ditto?characterEncoding=utf8&connectionTimeZone=Asia/Shanghai&forceConnectionTimeZoneToSession=true
SPRING_DATASOURCE_USERNAME=ditto
SPRING_DATASOURCE_PASSWORD=
SERVER_PORT=8080
